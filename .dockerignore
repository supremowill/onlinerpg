# .dockerignore — evita copiar arquivos desnecessários para a imagem Docker

# Node modules (serão reinstalados no container)
node_modules/
server/node_modules/

# TypeScript compilado local
server/dist/

# Arquivos de desenvolvimento
server/src/**/*.js.map
**/*.log
**/*.md

# Git e editor
.git/
.gitignore
.vscode/
.idea/

# Docker files (evita recursão)
docker-compose*.yml
